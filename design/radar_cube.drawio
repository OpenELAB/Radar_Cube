        <mxCell id="7CyqZpYL4BO0aw3nbGov-82" value="&lt;b&gt;Do you need a mode dedicated to CE certification without unlimited wake-up mode?&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" vertex="1" parent="1">
